# Copy to .env and edit. Real environment variables override this file.
LLM_URL=http://localhost:8000/v1/chat/completions
LLM_MODEL=anthropic/claude-haiku-5.5

# Benchmark settings
BENCH_LEVELS=1 2 4 8
BENCH_MAX_TOKENS=256
BENCH_TIMEOUT=120
BENCH_PROMPT=Write a short story about a robot learning to paint.
# true = leave the model's thinking on during the benchmark
BENCH_THINKING=false
